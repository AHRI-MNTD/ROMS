{
  "openapi": "3.0.3",
  "info": {
    "title": "ROMS API",
    "version": "0.1.0",
    "description": "Research Operations Management System REST API",
    "contact": { "name": "ROMS Team" }
  },
  "servers": [{ "url": "http://localhost:4000", "description": "Development" }],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "tags": ["Auth"],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "JWT tokens" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current user",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "User object" } }
      }
    },
    "/catalog/domains": {
      "get": {
        "summary": "List all domains",
        "tags": ["Catalog"],
        "responses": { "200": { "description": "Domain list" } }
      }
    },
    "/catalog/domains/{slug}": {
      "get": {
        "summary": "Get domain by slug",
        "tags": ["Catalog"],
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Domain with subfunctions and tasks" }, "404": { "description": "Not found" } }
      }
    },
    "/architecture/c4": {
      "get": {
        "summary": "Get C4 architecture model",
        "tags": ["Architecture"],
        "responses": { "200": { "description": "C4 model JSON" } }
      }
    },
    "/domains/biospecimen": {
      "get": { "summary": "List samples", "tags": ["Biospecimen"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Paginated samples" } } },
      "post": { "summary": "Create sample", "tags": ["Biospecimen"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created sample" } } }
    },
    "/domains/inventory": {
      "get": { "summary": "List stock items", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Paginated stock items" } } },
      "post": { "summary": "Create stock item", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created stock item" } } }
    },
    "/domains/inventory/{id}": {
      "get": { "summary": "Get stock item", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Stock item" }, "404": { "description": "Not found" } } },
      "patch": { "summary": "Update stock item", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated stock item" } } },
      "delete": { "summary": "Delete stock item", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Deleted stock item" } } }
    },
    "/domains/inventory/master-data": {
      "get": { "summary": "List inventory master data", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Paginated master data" } } },
      "post": { "summary": "Create inventory master data", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created master data" } } }
    },
    "/domains/inventory/master-data/projects": {
      "get": { "summary": "List inventory projects", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Project list" } } }
    },
    "/domains/inventory/requests": {
      "get": { "summary": "List inventory requests", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Request history" } } },
      "post": { "summary": "Create inventory request batch", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created requests" } } }
    },
    "/domains/inventory/request-decisions": {
      "post": { "summary": "Settle inventory request decisions", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Saved decisions" } } }
    },
    "/domains/inventory/movements": {
      "get": { "summary": "List inventory movements", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Movement history" } } }
    },
    "/domains/inventory/analytics": {
      "get": { "summary": "Inventory analytics", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Inventory analytics" } } }
    },
    "/domains/inventory/google-sheets/sync": {
      "post": { "summary": "Sync inventory with Google Sheets", "tags": ["Inventory"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Sync result" } } }
    },
    "/domains/qms/sops": {
      "get": { "summary": "List SOPs", "tags": ["QMS"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Paginated SOPs" } } },
      "post": { "summary": "Create SOP", "tags": ["QMS"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created SOP" } } }
    },
    "/domains/finance/grants": {
      "get": { "summary": "List grants", "tags": ["Finance"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Paginated grants" } } },
      "post": { "summary": "Create grant", "tags": ["Finance"], "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Created grant" } } }
    },
    "/domains/participant": {
      "get": { "summary": "List participants", "tags": ["Participant"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Paginated participants" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        }
      }
    }
  }
}
